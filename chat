<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>SCU Chat</title>
<style>
:root{color-scheme:dark}*{box-sizing:border-box}body{margin:0;background:#080c11;color:#e8edf2;font-family:Arial,sans-serif}.header{background:#111821;border-bottom:1px solid #293542;padding:16px 24px;display:flex;align-items:center;justify-content:space-between;gap:14px}.brand{display:flex;align-items:center;gap:12px}.logo{width:44px;height:44px;object-fit:contain}.brand h1{margin:0;font-size:19px;letter-spacing:1.2px}.brand p{margin:5px 0 0;color:#7f8c99;font-size:11px}.header-actions{display:flex;gap:8px;flex-wrap:wrap}button,input,textarea,select{font:inherit}button{cursor:pointer;border:1px solid #354554;border-radius:5px;background:#202c38;color:#e8edf2;padding:10px 13px;font-size:12px;font-weight:bold}button:hover{background:#2b3a48}button.primary{background:#1d4ed8;border-color:#2563eb;color:#fff}button.danger{background:#3a1518;border-color:#7f1d1d}.container{max-width:1450px;margin:auto;padding:22px}.page-title{margin:0 0 6px;font-size:22px}.subtext{color:#8996a3;font-size:13px;margin:0 0 20px}.chat-layout{display:grid;grid-template-columns:310px minmax(0,1fr);gap:16px;min-height:calc(100vh - 165px)}.panel{background:#111821;border:1px solid #293542;border-radius:8px;overflow:hidden}.sidebar-head{padding:16px;border-bottom:1px solid #293542;display:flex;justify-content:space-between;align-items:center;gap:8px}.sidebar-head h2,.conversation-head h2{font-size:14px;letter-spacing:.5px;margin:0}.room-list{max-height:calc(100vh - 280px);overflow:auto}.room-item{width:100%;text-align:left;border:0;border-bottom:1px solid #202b36;border-radius:0;background:transparent;padding:14px 16px;display:block;font-weight:normal}.room-item.active{background:#142333;border-left:3px solid #3b82f6;padding-left:13px}.room-name{font-size:13px;font-weight:bold;display:flex;align-items:center;justify-content:space-between;gap:8px}.room-preview{font-size:11px;color:#8996a3;margin-top:6px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.small-badge{display:inline-block;background:#dc2626;color:white;border-radius:10px;min-width:19px;text-align:center;padding:3px 6px;font-size:10px;font-weight:bold}.conversation{display:flex;flex-direction:column;min-height:540px}.conversation-head{padding:16px 18px;border-bottom:1px solid #293542;display:flex;align-items:center;justify-content:space-between;gap:12px}.conversation-meta{color:#8996a3;font-size:11px;margin-top:5px}.messages{flex:1;overflow:auto;padding:18px;display:flex;flex-direction:column;gap:12px;max-height:calc(100vh - 340px);min-height:340px}.message{max-width:min(78%,700px);align-self:flex-start;background:#1a2530;border:1px solid #293542;border-radius:8px;padding:10px 12px;overflow-wrap:anywhere}.message.mine{align-self:flex-end;background:#142a40;border-color:#234b70}.message-author{font-size:11px;font-weight:bold;color:#93c5fd;margin-bottom:5px}.message-body{font-size:13px;white-space:pre-wrap;line-height:1.45}.message-time{font-size:10px;color:#8996a3;text-align:right;margin-top:7px}.composer{border-top:1px solid #293542;padding:14px;display:flex;gap:10px;align-items:flex-end}.composer textarea{resize:vertical;min-height:44px;max-height:150px;flex:1;background:#080c11;border:1px solid #354554;border-radius:6px;color:#e8edf2;padding:12px;outline:none}.composer textarea:focus,input:focus,select:focus{border-color:#3b82f6;outline:none}.empty{padding:28px 18px;text-align:center;color:#8996a3;font-size:13px}.status{font-size:12px;color:#8996a3;padding:8px 16px}.modal-backdrop{position:fixed;inset:0;background:rgba(0,0,0,.72);display:none;align-items:center;justify-content:center;padding:18px;z-index:10}.modal{width:min(560px,100%);max-height:90vh;overflow:auto;background:#111821;border:1px solid #354554;border-radius:9px;padding:20px}.modal h2{margin:0 0 16px;font-size:18px}.field{margin:14px 0}.field label{display:block;color:#aab6c2;font-size:12px;margin-bottom:7px}.field input,.field select{width:100%;background:#080c11;color:#e8edf2;border:1px solid #354554;border-radius:5px;padding:11px}.officer-picker{border:1px solid #293542;border-radius:6px;max-height:260px;overflow:auto;padding:8px}.officer-choice{display:flex;gap:9px;align-items:center;padding:8px;font-size:12px}.officer-choice input{width:auto}.modal-actions{display:flex;justify-content:flex-end;gap:8px;margin-top:18px}.notice{padding:12px;border:1px solid #684d20;background:#211b11;color:#fbbf24;border-radius:6px;font-size:12px;margin-bottom:14px}.error{color:#fca5a5}.muted{color:#8996a3}@media(max-width:800px){.header{padding:13px}.brand h1{font-size:15px}.logo{width:36px;height:36px}.container{padding:14px}.chat-layout{grid-template-columns:1fr}.room-list{max-height:250px}.conversation{min-height:60vh}.messages{max-height:55vh}.message{max-width:92%}.header-actions button{padding:8px;font-size:10px}}
</style>
</head>
<body>
<header class="header">
 <div class="brand"><img class="logo" src="https://r2.fivemanage.com/PtUBr7btDsJIJroZ84fAB/SCU.webp" alt="SCU Logo"><div><h1>SCU COMMUNICATIONS</h1><p>STREET CRIMES UNIT • INTERNAL MESSAGING</p></div></div>
 <div class="header-actions"><button onclick="location.href='dashboard.html'">← DASHBOARD</button><button onclick="logout()">LOG OUT</button></div>
</header>
<main class="container">
 <h2 class="page-title">SCU Chat</h2><p class="subtext">Private conversations and restricted operational rooms.</p>
 <div id="notice" class="notice" style="display:none"></div>
 <div class="chat-layout">
  <aside class="panel"><div class="sidebar-head"><h2>CONVERSATIONS</h2><button id="newChatBtn" class="primary">+ NEW</button></div><div id="roomList" class="room-list"><div class="empty">Loading conversations…</div></div><div id="sidebarStatus" class="status"></div></aside>
  <section class="panel conversation"><div id="conversationHead" class="conversation-head"><div><h2>Select a conversation</h2><div class="conversation-meta">Your authorised chats appear here.</div></div></div><div id="messages" class="messages"><div class="empty">Choose a conversation or start a new one.</div></div><form id="composer" class="composer"><textarea id="messageInput" maxlength="5000" placeholder="Write a message…" disabled aria-label="Message text"></textarea><button class="primary" id="sendBtn" type="submit" disabled>SEND</button></form></section>
 </div>
</main>
<div id="newChatModal" class="modal-backdrop" role="dialog" aria-modal="true" aria-labelledby="modalTitle"><div class="modal"><h2 id="modalTitle">Start a conversation</h2><div id="permissionNote" class="muted" style="font-size:12px;margin-bottom:12px"></div><form id="newChatForm"><div class="field"><label for="chatType">Conversation type</label><select id="chatType"><option value="direct">Private direct message</option><option value="group">Group room</option></select></div><div class="field" id="roomNameField" style="display:none"><label for="roomName">Room name</label><input id="roomName" maxlength="80" placeholder="e.g. Operation Nightfall"></div><div class="field"><label id="memberLabel">Select detective</label><div id="officerPicker" class="officer-picker">Loading active officers…</div></div><div id="modalError" class="error" role="alert" style="font-size:12px"></div><div class="modal-actions"><button type="button" id="cancelNewChat">CANCEL</button><button type="submit" class="primary" id="createChatBtn">START CHAT</button></div></form></div></div>
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<script>
const SUPABASE_URL='https://mtlozyseibrefhxnocvb.supabase.co';
const SUPABASE_KEY='sb_publishable_IdOfodEMDP68oUfwh2KKWg_Z1wExmJ1';
const supabaseClient=window.supabase.createClient(SUPABASE_URL,SUPABASE_KEY);
let currentUserId=null,currentOfficer=null,rooms=[],activeRoomId=null,members=[],officers=[],messagesChannel=null,roomsChannel=null,unreadByRoom={};
const $=id=>document.getElementById(id);
function esc(v){return String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));}
function titleFor(o){const p=String(o.portal_title||'').trim();const r=String(o.rank||'').trim();return p||r||'Officer';}
function isChatHead(o){const role=String(o.role||'').toLowerCase();const title=titleFor(o).toLowerCase();return role==='master'||['head of scu','assistant head of scu','head of drugs','head of gangs','head of weapons'].includes(title);}
function showNotice(msg,isError=false){$('notice').textContent=msg;$('notice').style.display='block';$('notice').style.borderColor=isError?'#7f1d1d':'#684d20';$('notice').style.color=isError?'#fca5a5':'#fbbf24';}
function hideNotice(){$('notice').style.display='none';}
async function init(){const {data:{session},error}=await supabaseClient.auth.getSession();if(error||!session){location.href='index.html';return;}currentUserId=session.user.id;
 const {data:officer,error:offErr}=await supabaseClient.from('officers').select('id,full_name,callsign,rank,portal_title,role,active').eq('id',currentUserId).single();
 if(offErr||!officer){showNotice('Your officer profile could not be loaded. Please contact SCU portal administration.',true);return;}currentOfficer=officer;if(officer.active===false){showNotice('Your officer account is inactive. Chat access is unavailable.',true);return;}
 const {data:officerRows,error:officersError}=await supabaseClient.from('officers').select('id,full_name,callsign,rank,portal_title,role,active').eq('active',true).order('full_name');if(officersError){console.error(officersError);showNotice('Could not load the officer list. Check the officers table read policy.',true);}else officers=(officerRows||[]).filter(o=>o.id!==currentUserId);
 $('newChatBtn').style.display='inline-block';$('permissionNote').textContent=isChatHead(officer)?'You can create group rooms and invite selected officers.':'You can start a private message. Group rooms can be created by authorised SCU Heads.';
 if(!isChatHead(officer))Array.from($('chatType').options).find(o=>o.value==='group').disabled=true;
 await loadRooms();subscribeRooms();
}
async function loadRooms(){const {data:memRows,error:memErr}=await supabaseClient.from('chat_room_members').select('room_id,last_read_at').eq('user_id',currentUserId);if(memErr){console.error(memErr);showNotice('SCU Chat is not set up yet. Run the supplied SQL setup in Supabase first.',true);$('roomList').innerHTML='<div class="empty">Chat setup required. See the SQL setup file.</div>';return;}
 const ids=(memRows||[]).map(x=>x.room_id);unreadByRoom={};if(!ids.length){rooms=[];renderRooms();return;}
 const {data:roomRows,error:roomErr}=await supabaseClient.from('chat_rooms').select('id,name,room_type,created_by,created_at').in('id',ids).order('created_at',{ascending:false});if(roomErr){console.error(roomErr);showNotice('Could not load your authorised rooms.',true);return;}
 const {data:allMembers,error:allMemErr}=await supabaseClient.from('chat_room_members').select('room_id,user_id,last_read_at').in('room_id',ids);if(allMemErr)console.error(allMemErr);
 const lastRead=new Map((memRows||[]).map(x=>[x.room_id,x.last_read_at]));
 const {data:allMessages,error:msgErr}=await supabaseClient.from('chat_messages').select('room_id,sender_id,created_at').in('room_id',ids).neq('sender_id',currentUserId).order('created_at',{ascending:false}).limit(2000);
 if(msgErr)console.warn('Unread previews unavailable:',msgErr.message);
 for(const id of ids){const readAt=lastRead.get(id);unreadByRoom[id]=(allMessages||[]).filter(m=>m.room_id===id&&(!readAt||new Date(m.created_at)>new Date(readAt))).length;}
 rooms=(roomRows||[]).map(r=>({...r,last_read_at:lastRead.get(r.id),members:(allMembers||[]).filter(m=>m.room_id===r.id)}));renderRooms();
 if(activeRoomId&&!rooms.some(r=>r.id===activeRoomId)){activeRoomId=null;renderConversationEmpty();}
}
function roomDisplayName(room){if(room.room_type==='direct'){const other=room.members.find(m=>m.user_id!==currentUserId);const o=officers.find(x=>x.id===other?.user_id);if(o)return o.full_name+(o.callsign?' ('+o.callsign+')':'');}return room.name||'Untitled room';}
function roomPreview(room){return room.room_type==='direct'?'Private conversation':room.members.length+' members • Restricted room';}
function renderRooms(){if(!rooms.length){$('roomList').innerHTML='<div class="empty">No conversations yet.<br><br>Use + NEW to start a chat.</div>';$('sidebarStatus').textContent='';return;}
 $('roomList').innerHTML=rooms.map(r=>{const n=unreadByRoom[r.id]||0;return `<button class="room-item ${r.id===activeRoomId?'active':''}" data-room="${esc(r.id)}"><div class="room-name"><span>${esc(roomDisplayName(r))}</span>${n?`<span class="small-badge">${n>99?'99+':n}</span>`:''}</div><div class="room-preview">${esc(roomPreview(r))}</div></button>`;}).join('');$('roomList').querySelectorAll('[data-room]').forEach(b=>b.addEventListener('click',()=>openRoom(b.dataset.room)));const total=Object.values(unreadByRoom).reduce((a,b)=>a+b,0);$('sidebarStatus').textContent=total?`${total} unread message${total===1?'':'s'}`:'All caught up';}
function renderConversationEmpty(){$('conversationHead').innerHTML='<div><h2>Select a conversation</h2><div class="conversation-meta">Your authorised chats appear here.</div></div>';$('messages').innerHTML='<div class="empty">Choose a conversation or start a new one.</div>';$('messageInput').disabled=true;$('sendBtn').disabled=true;}
async function openRoom(id){activeRoomId=id;const room=rooms.find(r=>r.id===id);if(!room)return;renderRooms();$('conversationHead').innerHTML=`<div><h2>${esc(roomDisplayName(room))}</h2><div class="conversation-meta">${esc(roomPreview(room))}</div></div>`;$('messages').innerHTML='<div class="empty">Loading messages…</div>';$('messageInput').disabled=false;$('sendBtn').disabled=false;
 const {data,error}=await supabaseClient.from('chat_messages').select('id,room_id,sender_id,message_text,created_at').eq('room_id',id).order('created_at',{ascending:true}).limit(500);if(error){console.error(error);$('messages').innerHTML='<div class="empty error">Unable to load messages. Check chat table permissions.</div>';return;}renderMessages(data||[]);
 const {error:readErr}=await supabaseClient.from('chat_room_members').update({last_read_at:new Date().toISOString()}).eq('room_id',id).eq('user_id',currentUserId);if(readErr){console.error('Could not mark room as read:',readErr);showNotice('Messages loaded, but read status could not be saved.',true);}else{unreadByRoom[id]=0;renderRooms();}
 subscribeMessages(id);
}
function renderMessages(rows){if(!rows.length){$('messages').innerHTML='<div class="empty">No messages yet. Start the conversation.</div>';return;}$('messages').innerHTML=rows.map(m=>{const o=officers.find(x=>x.id===m.sender_id)||(m.sender_id===currentUserId?currentOfficer:null);const name=o?(o.full_name||'Officer')+(o.callsign?' ('+o.callsign+')':''):'SCU Officer';return `<article class="message ${m.sender_id===currentUserId?'mine':''}"><div class="message-author">${esc(name)}</div><div class="message-body">${esc(m.message_text)}</div><div class="message-time">${esc(new Date(m.created_at).toLocaleString())}</div></article>`;}).join('');$('messages').scrollTop=$('messages').scrollHeight;}
async function sendMessage(event){event.preventDefault();const text=$('messageInput').value.trim();if(!text||!activeRoomId)return;const roomId=activeRoomId;$('sendBtn').disabled=true;const {error}=await supabaseClient.from('chat_messages').insert({room_id:roomId,sender_id:currentUserId,message_text:text});$('sendBtn').disabled=false;if(error){console.error(error);showNotice('Message not sent. Check your connection and chat permissions.',true);return;}hideNotice();$('messageInput').value='';await loadRoomMessages(roomId);}
async function loadRoomMessages(id){if(activeRoomId!==id)return;const {data,error}=await supabaseClient.from('chat_messages').select('id,room_id,sender_id,message_text,created_at').eq('room_id',id).order('created_at',{ascending:true}).limit(500);if(error){console.error(error);return;}renderMessages(data||[]);const {error:readErr}=await supabaseClient.from('chat_room_members').update({last_read_at:new Date().toISOString()}).eq('room_id',id).eq('user_id',currentUserId);if(!readErr){unreadByRoom[id]=0;renderRooms();}}
function subscribeMessages(id){if(messagesChannel){supabaseClient.removeChannel(messagesChannel);messagesChannel=null;}messagesChannel=supabaseClient.channel('scu-chat-'+id).on('postgres_changes',{event:'INSERT',schema:'public',table:'chat_messages',filter:'room_id=eq.'+id},async payload=>{if(payload.new.sender_id!==currentUserId){await loadRoomMessages(id);}else{await loadRoomMessages(id);}}).subscribe();}
function subscribeRooms(){if(roomsChannel)supabaseClient.removeChannel(roomsChannel);roomsChannel=supabaseClient.channel('scu-chat-inbox-'+currentUserId).on('postgres_changes',{event:'*',schema:'public',table:'chat_messages'},async payload=>{if(payload.new?.room_id){if(payload.new.room_id===activeRoomId){await loadRoomMessages(activeRoomId);}else{await loadRooms();}}}).on('postgres_changes',{event:'*',schema:'public',table:'chat_room_members',filter:'user_id=eq.'+currentUserId},loadRooms).subscribe();}
function showNewChat(){hideNotice();$('modalError').textContent='';$('newChatModal').style.display='flex';renderOfficerPicker();updateChatType();}
function closeNewChat(){$('newChatModal').style.display='none';}
function updateChatType(){const group=$('chatType').value==='group';$('roomNameField').style.display=group?'block':'none';$('memberLabel').textContent=group?'Select detectives to invite':'Select one detective';$('createChatBtn').textContent=group?'CREATE ROOM':'START CHAT';$('officerPicker').querySelectorAll('input[type=checkbox]').forEach(i=>{i.type=group?'checkbox':'radio';i.name=group?'chatMembers':'chatMember';});}
function renderOfficerPicker(){if(!officers.length){$('officerPicker').innerHTML='<div class="empty">No other active officers were found.</div>';return;}$('officerPicker').innerHTML=officers.map(o=>`<label class="officer-choice"><input type="${$('chatType').value==='group'?'checkbox':'radio'}" name="${$('chatType').value==='group'?'chatMembers':'chatMember'}" value="${esc(o.id)}"><span><strong>${esc(o.full_name||'Unknown Officer')}</strong><br><span class="muted">${esc(titleFor(o))}${o.callsign?' • Callsign '+esc(o.callsign):''}</span></span></label>`).join('');}
async function createChat(event){event.preventDefault();$('modalError').textContent='';const type=$('chatType').value;const selected=Array.from($('officerPicker').querySelectorAll('input:checked')).map(i=>i.value);if(!selected.length){$('modalError').textContent='Select at least one detective.';return;}if(type==='group'&&!$('roomName').value.trim()){$('modalError').textContent='Enter a name for the group room.';return;}if(type==='group'&&!isChatHead(currentOfficer)){$('modalError').textContent='Only authorised SCU Heads can create group rooms.';return;}if(type==='direct'&&selected.length!==1){$('modalError').textContent='Select one detective for a private message.';return;}
 $('createChatBtn').disabled=true;try{if(type==='direct'){const {data:mine,error:mineErr}=await supabaseClient.from('chat_room_members').select('room_id').eq('user_id',currentUserId);if(!mineErr&&(mine||[]).length){const myIds=mine.map(m=>m.room_id);const {data:directs}=await supabaseClient.from('chat_rooms').select('id,room_type').in('id',myIds).eq('room_type','direct');for(const d of directs||[]){const {data:ms}=await supabaseClient.from('chat_room_members').select('user_id').eq('room_id',d.id);const ids=(ms||[]).map(m=>m.user_id).sort();if(ids.length===2&&ids.includes(currentUserId)&&ids.includes(selected[0])){closeNewChat();await loadRooms();await openRoom(d.id);return;}}}}
 const {data:room,error:roomErr}=await supabaseClient.from('chat_rooms').insert({name:type==='group'?$('roomName').value.trim():null,room_type:type,created_by:currentUserId}).select('id,name,room_type,created_by,created_at').single();if(roomErr)throw roomErr;const memberIds=[currentUserId,...selected];const uniqueIds=[...new Set(memberIds)];const {error:membersErr}=await supabaseClient.from('chat_room_members').insert(uniqueIds.map(user_id=>({room_id:room.id,user_id,last_read_at:new Date().toISOString()})));if(membersErr)throw membersErr;closeNewChat();await loadRooms();await openRoom(room.id);}catch(err){console.error(err);$('modalError').textContent=err.message||'Could not create conversation. Check the SQL policies and try again.';}finally{$('createChatBtn').disabled=false;}}
async function logout(){await supabaseClient.auth.signOut();location.href='index.html';}
$('newChatBtn').addEventListener('click',showNewChat);$('cancelNewChat').addEventListener('click',closeNewChat);$('chatType').addEventListener('change',()=>{renderOfficerPicker();updateChatType();});$('newChatForm').addEventListener('submit',createChat);$('composer').addEventListener('submit',sendMessage);$('newChatModal').addEventListener('click',e=>{if(e.target===$('newChatModal'))closeNewChat();});init();
</script>
</body>
</html>
